{
  "name": "@siglum/git",
  "version": "0.1.0",
  "description": "Browser-based Git operations using siglum-filesystem with isomorphic-git",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "bun test tests",
    "prepublishOnly": "bun run build && bun test tests"
  },
  "peerDependencies": {
    "isomorphic-git": "^1.36.0",
    "@siglum/filesystem": "^0.3.0"
  },
  "dependencies": {
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "isomorphic-git": "^1.36.1",
    "typescript": "~5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiglumProject/siglum-git"
  },
  "overrides": {
    "@siglum/filesystem": "file:../siglum-filesystem"
  },
  "publishConfig": {
    "access": "public"
  }
}
